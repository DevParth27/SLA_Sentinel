# ── LLM (REQUIRED — pipeline won't work without this) ────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here


# ── AWS S3 (needed when teammate connects S3 for PDF storage) ────
# Get from: AWS Console → IAM → Users → Create user → Access keys
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your_s3_bucket_name_here


# ── DATABASE (needed when Aurora PostgreSQL is set up via v0) ────
# Get from: AWS Console → RDS → your Aurora cluster → Connectivity
# Format: postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://your_db_user:your_db_password@your_aurora_host:5432/contracts_db


# ── FASTAPI SERVER ────────────────────────────────────────────────
# Port the FastAPI server runs on locally
PORT=8000

# Comma-separated list of allowed frontend origins for CORS
# Local dev:      http://localhost:3000
# After Vercel:   https://your-app-name.vercel.app
ALLOWED_ORIGINS=http://localhost:3000


# ── ENVIRONMENT FLAG ──────────────────────────────────────────────
# "development" = debug logs on
# "production"  = debug logs off
ENVIRONMENT=development
